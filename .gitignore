# Environments and caches
.venv/
__pycache__/
*.pyc
.ipynb_checkpoints/
.pytest_cache/
.DS_Store

# Raw data, model weights and large outputs stay local (hashes tracked in manifests).
# Documentation (terms-of-use checks, audits, manifests) lives beside these folders, never inside them.
research/**/data/
research/**/raw/
outputs/**/data/
outputs/**/raw/
*.safetensors
*.bin
*.pt
*.npz
*.parquet
outputs/*/dry/

# Literature PDFs (publisher and arXiv terms: personal research use, no redistribution; manifest tracked)
research/literature/pdfs/

# LaTeX intermediates (Stage 9)
research/paper/latex/*.aux
research/paper/latex/*.log
research/paper/latex/*.xdv
research/paper/latex/*.blg
research/paper/latex/*.out
research/paper/latex/*.toc

# Extracted text of literature PDFs (derived from copyrighted files; manifest tracked)
research/literature/txt/

# Large derived arrays (MinHash signatures, per-unit metadata) stay local; counts and summaries are tracked
*.npy
outputs/corpora_units_v0.1/*.parquet
outputs/study1_v0.1/validation/
outputs/study1_v0.2/validation*/
outputs/study1_v0.2/validation_run.log
outputs/study1_v0.2/validate_stdout.log
outputs/study1_v0.3/validation*/
outputs/study1_v0.3/validation_run.log
outputs/study1_v0.3/validate_stdout.log
outputs/study1_v0.3/results_pilot_*.json
# Study 2: the token cache (git-ignored; its manifest is tracked), validation pilots and pilot analyses
outputs/study2_v0.1/tokens/
outputs/study2_v0.1/validation*/
outputs/study2_v0.1/validation_run.log
outputs/study2_v0.1/results_pilot_*.json
outputs/study2_v0.1/token_cache_build.log
outputs/study2_v0.1/inputs_run.log
outputs/study2_v0.1/validate_stdout*.log
outputs/study2_v0.1/profile_cell_*.log

# Study 3: validation runs and the local threshold files stay local (digests in the run manifest); the evaluation counts (.npz) are the record
outputs/study3_v0.1/validation_*/
outputs/study3_v0.1/thresholds_local/
outputs/study3_v0.1/validation_thresholds/
!outputs/study3_v0.1/cells/*.npz

# Study 3: the locked analyzer's results.json (103 MB, above GitHub's file limit) stays local; its exact bytes are committed gzipped and its digest is in RUN_MANIFEST.json
outputs/study3_v0.1/results.json

# Study 4: the pilot's generated token arrays and prompt arrays stay local (the pilot summary JSON and the prompts manifest are tracked); the probe logs are tracked
outputs/study4_v0.1/pilot/gen/
outputs/study4_v0.1/pilot/prompts/
outputs/study4_v0.1/prompts/
outputs/study4_v0.1/validation_*/
# Study 4: the generation record (token arrays) and the analysis arrays are committed; the pilot-law and validation arrays stay local
!outputs/study4_v0.1/cells/*.npz
!outputs/study4_v0.1/results_arrays.npz
outputs/study4_v0.1/pilot_law/
outputs/study4_v0.1/prompts_superseded_pilot_overlap/

# the paper: filled section copies are regenerated by research/paper/fill_paper.py
research/paper/filled/
# copies of third-party web pages fetched by the bibliography builder (the extracted facts are tracked in pages/extracted.json)
research/paper/bib_sources/pages/*.html

# the rendered draft (HTML, PDFs, copied figures); regenerated by research/paper/assemble.py --render; the page counts are in paper_build.json
research/paper/render/

# the paper page built by tools/make_site.py (copied into the public snapshot; not tracked here)
docs/
